{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"rootDir": "..",
		"lib": ["ES2023", "DOM"],
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"types": ["bun", "node"],
		"noEmit": true
	},
	"include": ["src/**/*.ts", "checks/**/*.ts", "tools/**/*.ts"]
}
