# Copy to ignored .env.<project-id> and replace every placeholder privately.
# No credentials or keys. Database default is (default); HTTPS instance default is 2.
RELAY_REGION=<function-region>
RELAY_RUNTIME_SERVICE_ACCOUNT=<runtime-service-account-email>
RELAY_DATABASE_ID=<database-id>
RELAY_MAX_INSTANCES=<positive-integer>
