{
	"functions": {
		"source": ".",
		"runtime": "nodejs22",
		"ignore": [
			"node_modules",
			".emulator*",
			".deploy*",
			".env*",
			".firebase",
			"*-debug.log*",
			"checks",
			"tools",
			"*.example",
			"README.md",
			"DEPLOY.md"
		],
		"codebase": "aiki-push-relay"
	},
	"firestore": {
		"rules": "firestore.rules",
		"indexes": "firestore.indexes.json",
		"database": "(default)"
	},
	"emulators": {
		"auth": {
			"host": "127.0.0.1",
			"port": 19371
		},
		"firestore": {
			"host": "127.0.0.1",
			"port": 19372,
			"websocketPort": 19376
		},
		"functions": {
			"host": "127.0.0.1",
			"port": 19373
		},
		"hub": {
			"host": "127.0.0.1",
			"port": 19374
		},
		"logging": {
			"host": "127.0.0.1",
			"port": 19375
		},
		"ui": {
			"enabled": false
		},
		"singleProjectMode": false
	}
