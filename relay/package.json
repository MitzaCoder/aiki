{
	"name": "aiki-push-relay",
	"private": true,
	"main": "dist/index.js",
	"engines": {
		"node": "22"
	},
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.checks.json",
		"test:emulator": "bun run tools/emulators.ts test",
		"emulator:setup": "bun run tools/emulators.ts setup",
		"emulator:start": "bun run tools/emulators.ts start",
		"demo:stack": "bun run tools/demo-stack.ts",
		"test:demo": "bun test --preload ./checks/network-guard.ts ./checks/demo-stack.cases.ts",
		"test:cases": "bun test --preload ./checks/network-guard.ts ./checks/emulator.cases.ts",
		"format": "prettier --write \"src/**/*.ts\" \"checks/**/*.ts\" \"tools/**/*.ts\" \"*.json\"",
		"format:check": "prettier --check \"src/**/*.ts\" \"checks/**/*.ts\" \"tools/**/*.ts\" \"*.json\""
	},
	"dependencies": {
		"firebase-admin": "13.6.0",
		"firebase-functions": "6.6.0"
	},
	"devDependencies": {
		"@types/bun": "1.3.10",
		"firebase-tools": "14.22.0",
		"prettier": "3.6.2",
		"typescript": "5.9.3"
	}
}
