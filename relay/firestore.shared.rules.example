// Fragment only: paste INSIDE match /databases/{database}/documents in the existing policy.
// Firestore allows are ORed. These false rules do NOT override overlapping allows.
// Exclude isRelayCollection(collectionId) from EVERY overlapping allow, including recursive ones.
// Keep all unrelated application rules. Never deploy this fragment as a complete policy.
function isRelayCollection(collectionId) {
  return collectionId in [
    'relayAccounts', 'relayInstallations', 'relayChallenges', 'relayChallengeOperations',
    'relayTokenOwners', 'relayRoutes', 'relaySendAttempts', 'relayRateLimits',
    'relayControl', 'relayRuntime', 'relayAccountCleanup', 'relayRouteRevocations'
  ];
}
match /relayAccounts/{document=**} { allow read, write: if false; }
match /relayInstallations/{document=**} { allow read, write: if false; }
match /relayChallenges/{document=**} { allow read, write: if false; }
