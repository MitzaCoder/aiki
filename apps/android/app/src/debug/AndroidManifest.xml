<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true">
        <receiver android:name="io.github.mitzacoder.aiki.DebugRelayReceiver"
            android:exported="true" android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.mitzacoder.aiki.DEBUG_RELAY" />
            </intent-filter>
        </receiver>
        <!-- Debug builds only: lets adb (which holds DUMP) hand the app what FCM would, to test drawing, taps and
             registration without Google. Nothing else can send it. -->
        <receiver android:name="io.github.mitzacoder.aiki.DebugPushReceiver" android:exported="true" android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.mitzacoder.aiki.DEBUG_PUSH" />
            </intent-filter>
        </receiver>
        <!-- Debug builds only: puts a drawn picture on the clipboard, to try pasting images without a device that can copy one. -->
        <receiver android:name="io.github.mitzacoder.aiki.DebugClipboardReceiver" android:exported="true" android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.mitzacoder.aiki.DEBUG_COPY_IMAGE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
