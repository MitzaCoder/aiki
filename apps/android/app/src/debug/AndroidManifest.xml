<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true">
        <!-- Debug builds only: lets adb (which holds DUMP) hand the app what FCM would, to test drawing, taps and
             registration without Google. Nothing else can send it. -->
        <receiver android:name="com.mihaisaru.harness.DebugPushReceiver" android:exported="true" android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.mihaisaru.harness.DEBUG_PUSH" />
            </intent-filter>
        </receiver>
        <!-- Debug builds only: puts a drawn picture on the clipboard, to try pasting images without a device that can copy one. -->
        <receiver android:name="com.mihaisaru.harness.DebugClipboardReceiver" android:exported="true" android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.mihaisaru.harness.DEBUG_COPY_IMAGE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
